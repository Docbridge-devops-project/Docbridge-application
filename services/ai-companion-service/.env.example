PORT=3007
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_NAME=docbridge_db
DB_USER=docbridge_user
DB_PASSWORD=replace_with_database_password
DB_SSL=false

JWT_ACCESS_SECRET=replace_with_strong_secret_min_32_chars_access
LOG_LEVEL=debug

# Never commit the real OpenRouter key.
# Check model availability and pricing in OpenRouter before deployment.
# Never send real medical or patient data during the capstone.
# AI responses require human verification and are not medical advice.
OPENROUTER_API_KEY=replace_with_your_openrouter_key
OPENROUTER_MODEL=provider/model-name
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=DocBridge AI Companion
OPENROUTER_TIMEOUT_MS=30000
